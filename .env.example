# App
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_traffic_engine

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs
CONTENT_ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
STABILITY_API_KEY=

# Transactional email (registration verification). Blank is fine in dev — sends are
# skipped with a logged warning instead of failing registration.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@aitrafficengine.com
BREVO_SENDER_NAME=AI Traffic Engine

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
