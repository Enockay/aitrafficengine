# App
DEBUG=true
LOG_LEVEL=INFO
# Must be the URL the browser actually sits at (used for CORS allow-origin and for
# building email/OAuth redirect links) — with docker-compose's host port mapping
# (5273:5173) that's port 5273 locally, not the container-internal 5173. In Coolify,
# set this to the frontend's public domain.
FRONTEND_URL=http://localhost:5273
BACKEND_URL=http://localhost:8000

# Read client-side by the frontend (Vite only exposes VITE_-prefixed vars to the
# browser bundle). Must be a URL the visitor's browser can reach — not "localhost"
# and not the docker-compose service name "backend", since those only resolve inside
# the server's own containers. With docker-compose's host port mapping (8900:8000)
# that's port 8900 locally. In Coolify, set this to the backend's public domain/port.
VITE_API_URL=http://localhost:8900/api/v1

# Cloudflare Turnstile CAPTCHA on registration — get both keys from
# https://dash.cloudflare.com/?to=/:account/turnstile after adding a site. Secret key
# stays backend-only and must never be committed; the site key is meant to be public
# (it's embedded in the page) but still has to be present at frontend *build* time
# (see frontend/Dockerfile), so changing it needs a rebuild, not just a restart.
# Leave both blank to disable CAPTCHA (e.g. local dev).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_traffic_engine

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs
CONTENT_ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
STABILITY_API_KEY=

# Transactional email (registration verification). Blank is fine in dev — sends are
# skipped with a logged warning instead of failing registration.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@aitrafficengine.com
BREVO_SENDER_NAME=AI Traffic Engine

# Billing (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
